---
/**
 * A diff-pair side-by-side with the varied axis as a live toggle.
 *
 * A diff-pair holds the topic constant and varies exactly one axis, so the one
 * thing a reader wants to do with it is flip that variable and watch the prose
 * change under the same heading. Two columns side by side show the contrast;
 * they do not let you flip it. "Flip" mode swaps the two passages in place, in
 * the same position on the page, which is the reading the static layout cannot
 * give.
 *
 * Progressive enhancement is deliberate. The passages are rendered at build
 * time (they are Markdown, so they must be), both columns are in the HTML, and
 * the controls ship `hidden`. The script removes `hidden` and takes over. With
 * no JavaScript the page is exactly the two-column layout it was before, with
 * no dead buttons.
 */
interface Props {
  labelA: string;
  labelB: string;
  /** The axis this pair varies, for the toggle's label. */
  axis?: string;
  /** Short button labels: the two entry ids. */
  idA?: string;
  idB?: string;
}
const { labelA, labelB, axis = '', idA = 'A', idB = 'B' } = Astro.props;
const pickLabel = axis ? `Which ${axis} to show` : 'Which passage to show';
---
<div class="diff-pair-viewer" data-dpv>
  <div class="dpv-controls" data-dpv-controls hidden>
    <div class="dpv-group" role="group" aria-label="Layout">
      <button type="button" class="dpv-btn" data-dpv-view="side" aria-pressed="true">
        Side by side
      </button>
      <button type="button" class="dpv-btn" data-dpv-view="flip" aria-pressed="false">
        Flip
      </button>
    </div>
    <div class="dpv-group dpv-pick" role="group" aria-label={pickLabel} data-dpv-pick hidden>
      {axis && <span class="dpv-axis">{axis}</span>}
      <button type="button" class="dpv-btn" data-dpv-show="a" aria-pressed="true">{idA}</button>
      <button type="button" class="dpv-btn" data-dpv-show="b" aria-pressed="false">{idB}</button>
    </div>
  </div>

  <p class="dpv-status sr-only" data-dpv-status aria-live="polite"></p>

  <div class="diff-pair" data-dpv-grid>
    <div class="diff-col" data-dpv-col="a">
      <h3>{labelA}</h3>
      <slot name="a" />
    </div>
    <div class="diff-col" data-dpv-col="b">
      <h3>{labelB}</h3>
      <slot name="b" />
    </div>
  </div>
</div>

<style>
  /* A class selector that sets `display` outranks the user-agent
     `[hidden] { display: none }`, so without this the controls ship visible and
     the flip toggle never hides. Everything in this component is hidden by the
     attribute, so the override is scoped to the component root. */
  .diff-pair-viewer [hidden] {
    display: none !important;
  }

  .dpv-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-block: 1rem;
  }
  .dpv-group {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .dpv-axis {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
    margin-inline-end: 0.125rem;
  }
  .dpv-btn {
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.2;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .dpv-btn:hover {
    border-color: var(--sl-color-gray-4);
  }
  /* The pressed state uses a neutral surface plus the accent on the border and
     the text, not an accent fill. `custom.css` overrides --sl-color-accent-low
     to one dark navy for both themes, so an accent fill would put dark text on
     a dark background in light mode. */
  .dpv-btn[aria-pressed='true'] {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .dpv-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .diff-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .diff-col {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
  }
  .diff-pair[data-dpv-mode='flip'] {
    grid-template-columns: 1fr;
  }
  @media (max-width: 72rem) {
    .diff-pair {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // One viewer per diff-pair page today, but the selector is scoped per root so
  // several on one page stay independent.
  document.querySelectorAll('[data-dpv]').forEach((root) => {
    const controls = root.querySelector('[data-dpv-controls]');
    const pick = root.querySelector('[data-dpv-pick]');
    const grid = root.querySelector('[data-dpv-grid]');
    const status = root.querySelector('[data-dpv-status]');
    const cols = {
      a: root.querySelector('[data-dpv-col="a"]'),
      b: root.querySelector('[data-dpv-col="b"]'),
    };
    if (!controls || !grid || !cols.a || !cols.b) return;

    let view = 'side';
    let shown = 'a';

    function render() {
      grid.setAttribute('data-dpv-mode', view);
      if (pick) pick.hidden = view !== 'flip';
      for (const key of ['a', 'b']) {
        cols[key].hidden = view === 'flip' && shown !== key;
      }
      root.querySelectorAll('[data-dpv-view]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-dpv-view') === view));
      });
      root.querySelectorAll('[data-dpv-show]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-dpv-show') === shown));
      });
      if (status) {
        status.textContent =
          view === 'flip'
            ? `Showing ${cols[shown].querySelector('h3')?.textContent?.trim() ?? shown}`
            : 'Showing both passages';
      }
    }

    root.querySelectorAll('[data-dpv-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        view = btn.getAttribute('data-dpv-view') === 'flip' ? 'flip' : 'side';
        render();
      });
    });
    root.querySelectorAll('[data-dpv-show]').forEach((btn) => {
      btn.addEventListener('click', () => {
        shown = btn.getAttribute('data-dpv-show') === 'b' ? 'b' : 'a';
        render();
      });
    });

    // Arrow keys step through the pair while the toggle has focus, the usual
    // radio-group behaviour, so a reader can flip the varied axis back and
    // forth without moving the pointer.
    if (pick) {
      pick.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        shown = shown === 'a' ? 'b' : 'a';
        render();
        root.querySelector(`[data-dpv-show="${shown}"]`)?.focus();
      });
    }

    controls.hidden = false;
    render();
  });
</script>
